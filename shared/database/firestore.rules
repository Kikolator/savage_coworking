rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // true if user is signed in
    function signedIn() {
      return request.auth.uid != null;
    }
    // true if user is client
    function isClient() {
      return request.auth.token.client == true;
    }
    // true if user is admin
    function isAdmin() {
      return request.auth.token.admin == true;
    }
    // true if user is owner
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isValidDeskBookingStatus(status) {
      return status in ['pending', 'confirmed', 'checkedIn', 'completed', 'cancelled', 'noShow'];
    }

    function isValidDeskBookingSource(source) {
      return source in ['app', 'admin', 'system'];
    }

    function durationMinutes(startAt, endAt) {
      return (endAt.toMillis() - startAt.toMillis()) / (1000 * 60);
    }

    function hasValidDeskBookingCoreFields(data) {
      return data.userId is string
        && data.workspaceId is string
        && data.deskId is string
        && data.startAt is timestamp
        && data.endAt is timestamp
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && isValidDeskBookingStatus(data.status)
        && isValidDeskBookingSource(data.source)
        && data.endAt.toMillis() > data.startAt.toMillis()
        && durationMinutes(data.startAt, data.endAt) >= 30;
    }

    function hasValidDeskBookingOptionals(data) {
      return (('purpose' in data) ? data.purpose is string && data.purpose.size() <= 140 : true)
        && (('repeatSeriesId' in data) ? data.repeatSeriesId is string && data.repeatSeriesId.size() <= 64 : true)
        && (('cancellationReason' in data) ? data.cancellationReason is string && data.cancellationReason.size() <= 280 : true)
        && (('cancelledBy' in data) ? data.cancelledBy is string : true)
        && (('checkInAt' in data) ? data.checkInAt is timestamp : true)
        && (('checkOutAt' in data) ? data.checkOutAt is timestamp : true)
        && (('cancelledAt' in data) ? data.cancelledAt is timestamp : true);
    }

    // Note: validDeskBookingCreate removed - using new booking model with startAt/endAt

    function immutableDeskBookingFields(oldData, newData) {
      return newData.userId == oldData.userId
        && newData.workspaceId == oldData.workspaceId
        && newData.deskId == oldData.deskId
        && newData.startAt == oldData.startAt
        && newData.endAt == oldData.endAt
        && newData.source == oldData.source
        && newData.createdAt == oldData.createdAt;
    }

    function validDeskBookingTransition(oldStatus, newStatus) {
      return (oldStatus == 'pending' && (newStatus == 'confirmed' || newStatus == 'cancelled'))
        || (oldStatus == 'confirmed' && (newStatus == 'checkedIn' || newStatus == 'cancelled'))
        || (oldStatus == 'checkedIn' && (newStatus == 'completed' || newStatus == 'noShow'))
        || newStatus == oldStatus
        || isAdmin();
    }

    function validDeskBookingUpdate(oldData, newData) {
      return hasValidDeskBookingCoreFields(newData)
        && hasValidDeskBookingOptionals(newData)
        && newData.updatedAt >= request.time - duration.value(1, 'm')
        && (isAdmin() || (immutableDeskBookingFields(oldData, newData) && validDeskBookingTransition(oldData.status, newData.status)));
    }

    function isValidSubscriptionStatus(status) {
      return status in ['active', 'cancelled', 'expired', 'trial', 'past_due'];
    }

    function validSubscriptionTransition(oldStatus, newStatus) {
      return (oldStatus == 'trial' && (newStatus == 'active' || newStatus == 'cancelled'))
        || (oldStatus == 'active' && (newStatus == 'past_due' || newStatus == 'cancelled' || newStatus == 'expired'))
        || (oldStatus == 'past_due' && (newStatus == 'active' || newStatus == 'cancelled' || newStatus == 'expired'))
        || (oldStatus == 'cancelled' && newStatus == 'expired')
        || newStatus == oldStatus
        || isAdmin();
    }

    // Users collection allows write/read by owner and admin
    // MembershipSummary validation is handled by Cloud Functions (backend-only updates)
    match /users/{uid} {
      allow write: if signedIn() && (isOwner(uid) || isAdmin());
      allow read: if signedIn() && (isOwner(uid) || isAdmin());
    }

    // Member data can be written by owner and read by authenticated users
    match /member_data/{document} {
      allow create: if isOwner(request.resource.data.uid) || isAdmin();
      allow update: if isOwner(resource.data.uid)
        && request.resource.data.uid == resource.data.uid;
      allow read: if signedIn();
    }

    // Meeting Rooms and Desks can be written by admin, and read by authenticated users
    match /meeting_rooms/{document} {
      allow write: if isAdmin();
      allow read: if signedIn();
    }
    match /desks/{document} {
      allow write: if isAdmin();
      allow read: if signedIn();
    }
    match /workspaces/{document} {
      allow write: if isAdmin();
      allow read: if signedIn();
    }

    // checked in out sessions can be written and read by owner
    match /check_in_out_sessions/{document} {
      allow write: if isOwner(request.resource.data.uid) || isAdmin();
      allow read: if isOwner(resource.data.uid) || isAdmin();
    }

    // Bookings can be written and read by owner
    match /bookings/{document} {
      allow create: if isOwner(request.resource.data.member_id) 
        && isClient() 
        || isAdmin();
      allow update: if isOwner(request.resource.data.member_id) 
        && isClient() 
        || isAdmin();
      allow delete: if isAdmin();
      allow get: if isOwner(resource.data.member_id) || isAdmin();
      allow list: if signedIn();
    }

    // Can get ReferralCodes/doc if docId == ownerId
    // ReferralCodes can only be created by admin
    match /referralCodes/{documentId} {
      // allow read: if resource.data.ownerId == documentId;
      allow read: if true;
    } 

    match /deskBookings/{bookingId} {
      allow create: if signedIn()
        && (isOwner(request.resource.data.userId) || isAdmin())
       // && validDeskBookingCreate(request.resource.data);

      allow read: if signedIn()
        && (isOwner(resource.data.userId) || isAdmin());

      allow update: if signedIn()
        && (isAdmin() || isOwner(resource.data.userId))
        && validDeskBookingUpdate(resource.data, request.resource.data);

      allow delete: if isAdmin();
    }

    // Note: Old subscription and subscriptionPlans match blocks removed - see new model rules below

    // ============================================================================
    // New Subscription Model Rules
    // ============================================================================

    // Validation functions for new models
    function isValidPlanCategory(category) {
      return category in ['dayPass', 'explore', 'nomad', 'fix'];
    }

    function isValidBillingType(type) {
      return type in ['oneOff', 'recurring'];
    }

    function isValidBillingPeriod(period) {
      return period in ['day', 'month'];
    }

    function isValidAccessType(type) {
      return type in ['business', '24_7'];
    }

    function isValidSeatType(type) {
      return type in ['hot', 'fixed'];
    }

    function isValidPassBundleStatus(status) {
      return status in ['active', 'consumed', 'expired', 'cancelled'];
    }

    function isValidBookingType(type) {
      return type in ['desk', 'meetingRoom'];
    }

    function isValidBookingStatus(status) {
      return status in ['booked', 'checkedIn', 'completed', 'cancelled'];
    }

    function isValidBookingKind(kind) {
      return kind in ['subscription', 'passBundle'];
    }

    function isValidTimeFormat(time) {
      // Validate HH:mm format
      return time is string
        && time.size() == 5
        && time.matches('^[0-9]{2}:[0-9]{2}$');
    }

    function isValidDateString(date) {
      // Validate YYYY-MM-DD format
      return date is string
        && date.size() == 10
        && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isValidAllowedDaysOfWeek(days) {
      // Array of integers 0-6 (Sunday=0, Saturday=6)
      // Check each element is between 0 and 6
      return days is list
        && days.size() <= 7
        && (days.size() == 0 || (days[0] >= 0 && days[0] <= 6));
    }

    function hasValidBilling(data) {
      return data.type is string
        && isValidBillingType(data.type)
        && (data.type == 'oneOff' || (data.type == 'recurring' && data.period is string && isValidBillingPeriod(data.period)))
        && (!('intervalCount' in data) || (data.intervalCount is int && data.intervalCount > 0));
    }

    function hasValidAccess(data) {
      return data.type is string
        && isValidAccessType(data.type)
        && (!('allowedDaysOfWeek' in data) || isValidAllowedDaysOfWeek(data.allowedDaysOfWeek))
        && (!('startTime' in data) || isValidTimeFormat(data.startTime))
        && (!('endTime' in data) || isValidTimeFormat(data.endTime));
    }

    function hasValidQuota(data) {
      return hasValidAccess(data.access)
        && (!('dayPassCredits' in data) || (data.dayPassCredits is int && data.dayPassCredits > 0))
        && (!('deskHoursPerPeriod' in data) || (data.deskHoursPerPeriod is number && data.deskHoursPerPeriod >= 0))
        && (!('meetingHoursPerPeriod' in data) || (data.meetingHoursPerPeriod is number && data.meetingHoursPerPeriod >= 0))
        && (!('seatType' in data) || (data.seatType is string && isValidSeatType(data.seatType)));
    }

    function hasValidPricing(data) {
      return data.currency is string
        && data.currency.size() == 3
        && data.amount is int
        && data.amount > 0
        && data.billingDescription is string;
    }

    function hasValidDisplay(data) {
      return data.planName is string
        && data.planName.size() > 0
        && data.priceAmount is int
        && data.priceAmount > 0
        && data.priceCurrency is string
        && data.priceCurrency.size() == 3;
    }

    function hasValidExternal(data) {
      return (!('stripeProductId' in data) || data.stripeProductId is string || data.stripeProductId == null)
        && (!('stripePriceId' in data) || data.stripePriceId is string || data.stripePriceId == null);
    }

    function hasValidSubscriptionPlanCoreFields(data) {
      return data.name is string
        && data.name.size() > 0
        && data.name.size() <= 100
        && data.category is string
        && isValidPlanCategory(data.category)
        && hasValidBilling(data.billing)
        && hasValidQuota(data.quota)
        && hasValidPricing(data.pricing)
        && (!('external' in data) || hasValidExternal(data.external))
        && data.features is list
        && data.isActive is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validSubscriptionPlanCreate(data) {
      return hasValidSubscriptionPlanCoreFields(data)
        && data.createdAt == data.updatedAt;
    }

    function validSubscriptionPlanUpdate(oldData, newData) {
      return newData.updatedAt >= request.time - duration.value(1, 'm')
        && (!('name' in newData) || (newData.name is string && newData.name.size() > 0 && newData.name.size() <= 100))
        && (!('category' in newData) || (newData.category is string && isValidPlanCategory(newData.category)))
        && (!('billing' in newData) || hasValidBilling(newData.billing))
        && (!('quota' in newData) || hasValidQuota(newData.quota))
        && (!('pricing' in newData) || hasValidPricing(newData.pricing))
        && (!('external' in newData) || hasValidExternal(newData.external))
        && (!('features' in newData) || newData.features is list)
        && (!('isActive' in newData) || newData.isActive is bool)
        && (!('createdAt' in newData) || newData.createdAt == oldData.createdAt);
    }

    function hasValidSubscriptionCoreFields(data) {
      return data.userId is string
        && data.planId is string
        && data.status is string
        && isValidSubscriptionStatus(data.status)
        && hasValidBilling(data.billing)
        && hasValidQuota(data.effectiveQuota)
        && hasValidDisplay(data.display)
        && data.stripeCustomerId is string
        && data.currentPeriodStart is timestamp
        && data.currentPeriodEnd is timestamp
        && data.cancelAtPeriodEnd is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.currentPeriodEnd.toMillis() > data.currentPeriodStart.toMillis();
    }

    function hasValidSubscriptionOptionals(data) {
      return (!('stripeSubscriptionId' in data) || data.stripeSubscriptionId is string)
        && (!('overrides' in data) || (data.overrides is map && (!('deskHoursPerPeriod' in data.overrides) || (data.overrides.deskHoursPerPeriod is number && data.overrides.deskHoursPerPeriod >= 0)) && (!('meetingHoursPerPeriod' in data.overrides) || (data.overrides.meetingHoursPerPeriod is number && data.overrides.meetingHoursPerPeriod >= 0))))
        && (!('cancelledAt' in data) || data.cancelledAt is timestamp)
        && (!('cancelledBy' in data) || data.cancelledBy is string)
        && (!('assignedDeskId' in data) || data.assignedDeskId is string);
    }

    function validSubscriptionCreate(data) {
      return hasValidSubscriptionCoreFields(data)
        && hasValidSubscriptionOptionals(data)
        && data.createdAt == data.updatedAt
        && data.billing.type == 'recurring'
        && (!('stripeSubscriptionId' in data) || data.stripeSubscriptionId is string);
    }

    function immutableSubscriptionFields(oldData, newData) {
      return newData.userId == oldData.userId
        && newData.planId == oldData.planId
        && newData.createdAt == oldData.createdAt;
    }

    function validSubscriptionUpdate(oldData, newData) {
      return hasValidSubscriptionCoreFields(newData)
        && hasValidSubscriptionOptionals(newData)
        && newData.updatedAt >= request.time - duration.value(1, 'm')
        && immutableSubscriptionFields(oldData, newData)
        && (isAdmin() || validSubscriptionTransition(oldData.status, newData.status))
        && (!('overrides' in newData) || isAdmin()); // Only admins can set overrides
    }

    function hasValidPassBundleCoreFields(data) {
      return data.userId is string
        && data.planId is string
        && data.status is string
        && isValidPassBundleStatus(data.status)
        && data.totalCredits is int
        && data.totalCredits > 0
        && data.remainingCredits is int
        && data.remainingCredits >= 0
        && data.remainingCredits <= data.totalCredits
        && data.validFrom is timestamp
        && (!('validUntil' in data) || (data.validUntil is timestamp && data.validUntil.toMillis() > data.validFrom.toMillis()))
        && hasValidAccess(data.access)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validPassBundleCreate(data) {
      return hasValidPassBundleCoreFields(data)
        && data.createdAt == data.updatedAt;
    }

    function validPassBundleUpdate(oldData, newData) {
      return hasValidPassBundleCoreFields(newData)
        && newData.updatedAt >= request.time - duration.value(1, 'm')
        && newData.userId == oldData.userId
        && newData.planId == oldData.planId
        && newData.createdAt == oldData.createdAt
        && (!('status' in newData) || isValidPassBundleStatus(newData.status))
        && (!('remainingCredits' in newData) || (newData.remainingCredits is int && newData.remainingCredits >= 0 && newData.remainingCredits <= newData.totalCredits));
    }

    function hasValidUsageCoreFields(data) {
      return data.userId is string
        && (data.subscriptionId is string || data.passBundleId is string)
        && !(data.subscriptionId is string && data.passBundleId is string) // Exactly one must be set
        && data.periodStart is timestamp
        && data.periodEnd is timestamp
        && data.periodEnd.toMillis() > data.periodStart.toMillis()
        && data.deskMinutesUsed is int
        && data.deskMinutesUsed >= 0
        && data.meetingMinutesUsed is int
        && data.meetingMinutesUsed >= 0
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Note: Usage validation functions removed - usage collection is backend-only (allow create/update: if false)

    function hasValidBookingSource(data) {
      return data.kind is string
        && isValidBookingKind(data.kind)
        && ((data.kind == 'subscription' && data.subscriptionId is string && !('passBundleId' in data))
          || (data.kind == 'passBundle' && data.passBundleId is string && !('subscriptionId' in data)));
    }

    function hasValidBookingCoreFields(data) {
      return data.userId is string
        && data.type is string
        && isValidBookingType(data.type)
        && data.startAt is timestamp
        && data.endAt is timestamp
        && data.endAt.toMillis() > data.startAt.toMillis()
        && hasValidBookingSource(data.source)
        && data.status is string
        && isValidBookingStatus(data.status)
        && data.workspaceId is string
        && ((data.type == 'desk' && data.deskId is string && !('roomId' in data))
          || (data.type == 'meetingRoom' && data.roomId is string && !('deskId' in data)))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validBookingCreate(data) {
      return hasValidBookingCoreFields(data)
        && data.createdAt == data.updatedAt
        && data.status == 'booked';
    }

    function validBookingUpdate(oldData, newData) {
      return hasValidBookingCoreFields(newData)
        && newData.updatedAt >= request.time - duration.value(1, 'm')
        && newData.userId == oldData.userId
        && newData.type == oldData.type
        && newData.startAt == oldData.startAt
        && newData.endAt == oldData.endAt
        && newData.source == oldData.source
        && newData.workspaceId == oldData.workspaceId
        && newData.createdAt == oldData.createdAt
        && (!('status' in newData) || isValidBookingStatus(newData.status));
    }

    // New Subscription Plans collection (updated structure)
    match /subscriptionPlans/{planId} {
      allow read: if signedIn();
      allow create: if isAdmin() && validSubscriptionPlanCreate(request.resource.data);
      allow update: if isAdmin() && validSubscriptionPlanUpdate(resource.data, request.resource.data);
      allow delete: if isAdmin();
    }

    // Subscriptions collection (updated structure - recurring only)
    match /subscriptions/{subscriptionId} {
      allow read: if signedIn() && (isOwner(resource.data.userId) || isAdmin());
      allow create: if signedIn() && (isOwner(request.resource.data.userId) || isAdmin()) && validSubscriptionCreate(request.resource.data);
      allow update: if signedIn() && (isAdmin() || isOwner(resource.data.userId)) && validSubscriptionUpdate(resource.data, request.resource.data);
      allow delete: if isAdmin();
    }

    // Pass Bundles collection
    match /passBundles/{bundleId} {
      allow read: if signedIn() && (isOwner(resource.data.userId) || isAdmin());
      allow create: if signedIn() && (isOwner(request.resource.data.userId) || isAdmin()) && validPassBundleCreate(request.resource.data);
      allow update: if signedIn() && (isAdmin() || isOwner(resource.data.userId)) && validPassBundleUpdate(resource.data, request.resource.data);
      allow delete: if isAdmin();
    }

    // Usage collection
    match /usage/{usageId} {
      allow read: if signedIn() && (isOwner(resource.data.userId) || isAdmin());
      // Only backend/Cloud Functions can create/update usage (users cannot)
      allow create: if false; // Enforced by backend only
      allow update: if false; // Enforced by backend only
      allow delete: if isAdmin();
    }

    // Bookings collection (new structure)
    match /bookings/{bookingId} {
      allow read: if signedIn() && (isOwner(resource.data.userId) || isAdmin());
      allow create: if signedIn() && (isOwner(request.resource.data.userId) || isAdmin()) && validBookingCreate(request.resource.data);
      allow update: if signedIn() && (isAdmin() || isOwner(resource.data.userId)) && validBookingUpdate(resource.data, request.resource.data);
      allow delete: if isAdmin();
    }
  }
}